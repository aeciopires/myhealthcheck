# Copy to ".env" and adjust: cp config/env.example .env
# Every variable is optional. See docs/configuration.md for the full list.

# ---- API / logs
HTTP_PORT=8000
LOG_LEVEL=INFO

# ---- checks
CHECK_INTERVAL=60            # seconds between check cycles
REQUEST_TIMEOUT=5            # seconds
RESPONSE_TIME_THRESHOLD=3.0  # slower answers are "degraded"
RETRY_ATTEMPTS=3             # only network errors, timeouts and 5xx are retried
RETRY_DELAY=2                # seconds
DEFAULT_HEALTH_PATHS=/status,/health,/healthz,/livez,/readyz,/ready,/ping,/-/healthy,/-/ready,/api/health,/health/live,/health/ready,/actuator/health,/q/health,/_health,/healthcheck

# ---- static targets
TARGETS_FILE=config/targets.yaml
# HEALTH_ENDPOINTS=http://kube-pires:3000/readyz,https:10.0.0.5:8443/status

# ---- kubernetes discovery
DISCOVERY_ENABLED=false
# DISCOVERY_NAMESPACES=default,apps        # empty = all namespaces (globs allowed)
# DISCOVERY_EXCLUDE_NAMESPACES=kube-system,kube-public,kube-node-lease
# DISCOVERY_PORTS=80,8080,8888             # "*" = every TCP port of the service
# DISCOVERY_LABEL_SELECTOR=app.kubernetes.io/part-of=shop
# DISCOVERY_INTERVAL=300
# K8S_CONTEXT=kind-kind                    # only outside the cluster

# ---- storage (falls back to the temp dir, then to memory)
DB_PATH=data/myhealthcheck.db
HISTORY_RETENTION=100

# ---- tracing (OpenTelemetry OTLP/HTTP)
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- alerts on status change (JSON POST)
# ALERT_WEBHOOK_URL=https://example.com/hook
