    {
      "type": "table",
      "title": "Current status",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "myhealthcheck_target_status{namespace=~\"$namespace\", source=~\"$source\", name=~\"$target\"} == 1",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "myhealthcheck_target_response_seconds{namespace=~\"$namespace\", source=~\"$source\", name=~\"$target\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "name": 0,
              "namespace": 1,
              "source": 2,
              "status": 3,
              "Value #B": 4,
              "target": 5
            },
            "renameByName": {
              "name": "Name",
              "namespace": "Namespace",
              "source": "Source",
              "status": "Status",
              "target": "Target id",
              "Value #B": "Response time"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "up": {
                        "color": "green",
                        "index": 0,
                        "text": "UP"
                      },
                      "degraded": {
                        "color": "orange",
                        "index": 1,
                        "text": "DEGRADED"
                      },
                      "down": {
                        "color": "red",
                        "index": 2,
                        "text": "DOWN"
                      },
                      "unknown": {
                        "color": "gray",
                        "index": 3,
                        "text": "UNKNOWN"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Response time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Status",
            "desc": false
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 6
