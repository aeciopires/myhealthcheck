{
  "title": "myhealthcheck",
  "uid": "myhealthcheck",
  "description": "Availability of monitored systems: metrics (Prometheus), logs (Loki) and traces (Tempo).",
  "tags": [
    "myhealthcheck",
    "health",
    "availability"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "time": {
    "from": "now-3h",
    "to": "now"
